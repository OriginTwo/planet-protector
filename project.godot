; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Planet Protector"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Palette="*res://scene/autoload/palette.gd"
Global="*res://scene/autoload/global.gd"
HitstopManager="*res://scene/autoload/hitstop_manager.gd"

[display]

window/size/viewport_width=384
window/size/viewport_height=240
window/size/window_width_override=1152
window/size/window_height_override=720
window/stretch/mode="viewport"

[layer_names]

2d_physics/layer_1="planet_hurtbox"
2d_physics/layer_2="asteroid_hurtbox"

[rendering]

textures/canvas_textures/default_texture_filter=0
